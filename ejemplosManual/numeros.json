{
  "version": "1",
  "tipo": "ProblemaTipo",
  "nombre": "numeros",
  "seed": 1,
  "setup": "import numpy as np\na = int(np.random.randint(1, 10))\nb = int(np.random.randint(1, 10))\nsuma = a + b\nproducto = a * b\nsuma_falsa = suma + 1\nproducto_falso = producto + a",
  "export": {"last_choice": true, "cols": 2, "instances": 4},
  "componentes": [
    "Sean $a = @{a}$ y $b = @{b}$ dos números naturales. Se sabe que ",
    [
      {
        "tipo": "Supuesto",
        "enunciado": "$a > b$. ",
        "semantica": "True",
        "precond": "lambda ns: ns['a'] > ns['b']"
      },
      {
        "tipo": "Supuesto",
        "enunciado": "$a < b$. ",
        "semantica": "True",
        "precond": "lambda ns: ns['a'] < ns['b']"
      },
      {
        "tipo": "Supuesto",
        "enunciado": "$a = b$. ",
        "semantica": "True",
        "precond": "lambda ns: ns['a'] == ns['b']"
      },
      {
        "tipo": "Supuesto",
        "enunciado": "$a \\ne b$. ",
        "semantica": "True",
        "precond": "lambda ns: ns['a'] != ns['b']"
      }
    ],
    "Indique qué afirmaciones son correctas: ",
    [
      {
        "tipo": "Cuestion",
        "enunciado": "$a + b = @{suma}$",
        "semantica": "True",
        "precond": "True",
        "exp": "Porque $@{a} + @{b} = @{suma}$."
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$a + b = @{suma_falsa}$",
        "semantica": "False",
        "precond": "True",
        "exp": "Porque $@{a} + @{b} = @{suma}$, no @{suma_falsa}."
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$a \\cdot b = @{producto}$",
        "semantica": "True",
        "precond": "True",
        "exp": "Porque $@{a} \\cdot @{b} = @{producto}$."
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$a \\cdot b = @{producto_falso}$",
        "semantica": "False",
        "precond": "True",
        "exp": "Porque $@{a} \\cdot @{b} = @{producto}$, no @{producto_falso}."
      }
    ],
    [
      {
        "tipo": "Cuestion",
        "enunciado": "$a - b > 0$",
        "semantica": "lambda ns: ns['a'] - ns['b'] > 0",
        "precond": "True",
        "exp": "$a - b = @{a} - @{b}$: positivo solo si $a > b$."
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$b - a > 0$",
        "semantica": "lambda ns: ns['b'] - ns['a'] > 0",
        "precond": "True",
        "exp": "$b - a = @{b} - @{a}$: positivo solo si $a < b$."
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$a \\cdot b > a + b$",
        "semantica": "lambda ns: ns['producto'] > ns['suma']",
        "precond": "True",
        "exp": "Con $a = @{a}$ y $b = @{b}$: $a \\cdot b = @{producto}$ y $a + b = @{suma}$."
      }
    ]
  ]
}
