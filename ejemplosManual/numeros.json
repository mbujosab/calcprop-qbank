{
  "version": "1",
  "tipo": "ProblemaTipo",
  "nombre": "sumas_y_productos",
  "setup": "import random\na = random.randint(2, 9)\nb = random.randint(2, 9)\nsuma = a + b\nproducto = a * b",
  "componentes": [
    "Sean $a = @a$ y $b = @b$ dos números naturales. Se sabe que ",
    [
      {
        "tipo": "Supuesto",
        "enunciado": "$a > b$. ",
        "semantica": "True",
        "precond": "lambda ns: ns['a'] > ns['b']"
      },
      {
        "tipo": "Supuesto",
        "enunciado": "$a < b$. ",
        "semantica": "True",
        "precond": "lambda ns: ns['a'] < ns['b']"
      },
      {
        "tipo": "Supuesto",
        "enunciado": "$a = b$. ",
        "semantica": "True",
        "precond": "lambda ns: ns['a'] == ns['b']"
      }
    ],
    "Indique qué afirmación es correcta: ",
    [
      {
        "tipo": "Cuestion",
        "enunciado": "$a + b = @suma$",
        "semantica": "True",
        "precond": "True",
        "exp": "Por definición de @suma"
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$a \\cdot b = @producto$",
        "semantica": "True",
        "precond": "True",
        "exp": "Por definición de @producto"
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$a - b > 0$",
        "semantica": "lambda ns: ns['a'] - ns['b'] > 0",
        "precond": "True",
        "exp": "Cierto solo si $a > b$"
      },
      {
        "tipo": "Cuestion",
        "enunciado": "$b - a > 0$",
        "semantica": "lambda ns: ns['b'] - ns['a'] > 0",
        "precond": "True",
        "exp": "Cierto solo si $a < b$"
      }
    ]
  ]
}
